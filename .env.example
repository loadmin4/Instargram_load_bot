# ============================================================
# 검색 방식 (하나 이상 설정해야 합니다)
#   1) 크롤링: 인스타그램 계정으로 로그인해 지정한 @계정 / #해시태그 의 게시물을 직접 비교
#   2) AI + 크롤링: Claude 가 사진을 보고 뒤질 @계정 / #해시태그 를 골라줌 (1 필요)
#   3) Google Lens (선택): SerpApi 로 인스타그램 전체에서 찾기
# ============================================================

# ---- 1) 크롤링: 인스타그램 로그인 ----
# 정지될 위험이 있으니 개인 계정 대신 검색용 부계정을 권장합니다.
INSTAGRAM_USERNAME=
# 비워두고 `python -m insta_finder.login` 으로 한 번 로그인하는 것을 권장합니다 (세션 파일에 저장).
INSTAGRAM_PASSWORD=
# 로그인 세션 저장 위치 (비밀번호처럼 다루세요)
INSTAGRAM_SESSION_FILE=instagram.session

# 대상 하나당 최대로 비교할 게시물 수 (클수록 오래 걸리고 요청이 많아짐)
CRAWL_MAX_POSTS=200
# 같은 사진으로 판단할 유사도 (0~1)
CRAWL_MATCH_THRESHOLD=0.82
# 이만큼 찾으면 검색 중단 (0 = 끝까지)
CRAWL_MAX_MATCHES=3
# 한 번에 지정할 수 있는 최대 대상 수
CRAWL_MAX_TARGETS=5

# ---- AI 가 검색 대상 고르기 (선택, 크롤링 설정 필요) ----
# Claude API 키 (https://console.anthropic.com). 설정하면 @/# 없이 사진만 보내도
# AI 가 사진 속 장소·간판·워터마크를 보고 뒤질 해시태그/계정을 골라 크롤링합니다.
ANTHROPIC_API_KEY=
# 사용할 Claude 모델
AI_MODEL=claude-opus-5-5
# AI 가 고른 대상 하나당 비교할 최대 게시물 수 (추정이라 직접 지정할 때보다 적게)
AI_MAX_POSTS=100

# ---- 텔레그램 봇 ----
# @BotFather 에게 받은 토큰
TELEGRAM_BOT_TOKEN=
# 봇을 쓸 수 있는 텔레그램 사용자 ID (쉼표로 구분, 비워두면 누구나 사용 가능)
# 다른 사람이 내 인스타그램 계정으로 크롤링하지 못하도록 설정을 강력히 권장합니다.
ALLOWED_USER_IDS=

# ---- 2) Google Lens (선택) ----
# SerpApi API 키 (https://serpapi.com/manage-api-key). 비워두면 이 방식은 꺼집니다.
SERPAPI_API_KEY=
# 검색 종류 (exact_matches, visual_matches 중 하나 이상, 쉼표로 구분)
SEARCH_TYPES=exact_matches,visual_matches
# 최대 결과 수
MAX_RESULTS=10
# Google Lens 언어/국가 (결과 제목 형식이 일정하도록 en 권장)
LENS_LANGUAGE=en
LENS_COUNTRY=
# Lens 검색에 함께 넣을 검색어 (예: instagram). 비워두면 사진만으로 검색
LENS_QUERY=
# 검색 결과 썸네일을 내려받아 원본 사진과의 유사도를 계산 (1=켜기, 0=끄기)
VERIFY_THUMBNAILS=1
# 사용자 이름을 알 수 없는 상위 N개 게시물의 게시자를 추가 조회
# 인스타그램 로그인이 설정돼 있으면 그 세션으로(기본 3), 없으면 Google 검색으로(기본 0, 건당 크레딧 1회) 조회
RESOLVE_USERNAMES=
