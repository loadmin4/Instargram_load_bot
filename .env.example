# 필수: SerpApi API 키 (https://serpapi.com/manage-api-key)
SERPAPI_API_KEY=

# 텔레그램 봇을 쓸 때 필수: @BotFather 에게 받은 토큰
TELEGRAM_BOT_TOKEN=

# 선택: 봇을 쓸 수 있는 텔레그램 사용자 ID (쉼표로 구분, 비워두면 누구나 사용 가능)
# 검색 1회마다 SerpApi 크레딧이 차감되므로 설정을 권장합니다.
ALLOWED_USER_IDS=

# 선택: 검색 종류 (exact_matches, visual_matches 중 하나 이상, 쉼표로 구분)
SEARCH_TYPES=exact_matches,visual_matches

# 선택: 최대 결과 수
MAX_RESULTS=10

# 선택: Google Lens 언어/국가 (결과 제목 형식이 일정하도록 en 권장)
LENS_LANGUAGE=en
LENS_COUNTRY=

# 선택: Lens 검색에 함께 넣을 검색어 (예: instagram). 비워두면 사진만으로 검색
LENS_QUERY=

# 선택: 검색 결과 썸네일을 내려받아 원본 사진과의 유사도를 계산 (1=켜기, 0=끄기)
VERIFY_THUMBNAILS=1

# 선택: 사용자 이름을 알 수 없는 게시물에 대해 Google 검색으로 게시자를 추가 조회
# 게시물 1건당 SerpApi 크레딧 1회가 추가로 사용됩니다. (0=끄기, N=상위 N건 조회)
RESOLVE_USERNAMES=0
